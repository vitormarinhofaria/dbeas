<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>DBeasy — licenças de terceiros</title>
<style>
  body { font-family: sans-serif; max-width: 960px; margin: 2em auto; padding: 0 1em; color: #222; }
  h1, h2 { font-weight: 600; }
  .licenses-list { list-style: none; padding: 0; }
  .license { margin-top: 2.5em; border-top: 1px solid #ccc; padding-top: 1em; }
  .license-used-by { margin: .5em 0 1em; }
  pre.license-text { white-space: pre-wrap; background: #f6f6f6; padding: 1em; font-size: 12px; }
